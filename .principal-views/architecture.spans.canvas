{
  "pv": {
    "name": "Principal View CLI Span Conventions",
    "version": "1.0.0",
    "markdown": ".principal-views/architecture.spans.md",
    "nodeTypes": {
      "span-convention": {
        "label": "Span Convention",
        "description": "A span convention defining an operation type",
        "color": "#3B82F6"
      }
    }
  },
  "nodes": [
    {
      "id": "cli-command",
      "type": "text",
      "x": 0,
      "y": 200,
      "width": 220,
      "height": 100,
      "text": "# CLI Entry Point\n\nCLI invocation entry point",
      "pv": {
        "nodeType": "span-convention",
        "status": "draft",
        "otel": {
          "spanPattern": "cli.command",
          "spanKind": "SERVER"
        }
      }
    },
    {
      "id": "validate",
      "type": "text",
      "x": 320,
      "y": 0,
      "width": 220,
      "height": 100,
      "text": "# Validation Operations\n\nCanvas, workflow, trace validation",
      "pv": {
        "nodeType": "span-convention",
        "status": "draft",
        "otel": {
          "spanPattern": "validate.*",
          "spanKind": "INTERNAL"
        }
      }
    },
    {
      "id": "discover",
      "type": "text",
      "x": 320,
      "y": 150,
      "width": 220,
      "height": 100,
      "text": "# Discovery Operations\n\nLibrary, canvas, workflow discovery",
      "pv": {
        "nodeType": "span-convention",
        "status": "draft",
        "otel": {
          "spanPattern": "discover.*",
          "spanKind": "INTERNAL"
        }
      }
    },
    {
      "id": "parse",
      "type": "text",
      "x": 320,
      "y": 300,
      "width": 220,
      "height": 100,
      "text": "# Parsing Operations\n\nCanvas, YAML, JSON parsing",
      "pv": {
        "nodeType": "span-convention",
        "status": "draft",
        "otel": {
          "spanPattern": "parse.*",
          "spanKind": "INTERNAL"
        }
      }
    },
    {
      "id": "file",
      "type": "text",
      "x": 640,
      "y": 150,
      "width": 220,
      "height": 100,
      "text": "# File Operations\n\nFile system read/write",
      "pv": {
        "nodeType": "span-convention",
        "status": "draft",
        "otel": {
          "spanPattern": "file.*",
          "spanKind": "INTERNAL"
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "fromNode": "cli-command",
      "fromSide": "right",
      "toNode": "validate",
      "toSide": "left",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e2",
      "fromNode": "cli-command",
      "fromSide": "right",
      "toNode": "discover",
      "toSide": "left",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e3",
      "fromNode": "cli-command",
      "fromSide": "right",
      "toNode": "parse",
      "toSide": "left",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e4",
      "fromNode": "validate",
      "fromSide": "bottom",
      "toNode": "discover",
      "toSide": "top",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e5",
      "fromNode": "validate",
      "fromSide": "bottom",
      "toNode": "parse",
      "toSide": "top",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e6",
      "fromNode": "discover",
      "fromSide": "right",
      "toNode": "file",
      "toSide": "left",
      "pv": { "edgeType": "data-flow" }
    },
    {
      "id": "e7",
      "fromNode": "parse",
      "fromSide": "right",
      "toNode": "file",
      "toSide": "left",
      "pv": { "edgeType": "data-flow" }
    }
  ]
}
