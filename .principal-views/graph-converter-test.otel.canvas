{
  "nodes": [
    {
      "id": "test-setup",
      "type": "text",
      "text": "# Test Setup\n\nCreate test configuration\n\n**Event:** setup.started",
      "x": -300,
      "y": 0,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "setup",
        "name": "Test Setup",
        "description": "Begin test setup phase",
        "shape": "hexagon",
        "fill": "#8b5cf6",
        "otel": {
          "resourceMatch": {
            "span.kind": "test.case"
          }
        },
        "event": {
          "name": "setup.started",
          "description": "Begin test setup phase",
          "attributes": {
            "description": {
              "type": "string",
              "description": "Description of what is being set up",
              "required": false
            }
          }
        }
      }
    },
    {
      "id": "test-setup-2",
      "type": "text",
      "text": "# Test Setup\n\nCreate test configuration\n\n**Event:** setup.complete",
      "x": -300,
      "y": 150,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "setup",
        "name": "Test Setup",
        "description": "Test setup completed successfully",
        "shape": "hexagon",
        "fill": "#8b5cf6",
        "otel": {
          "resourceMatch": {
            "span.kind": "test.case"
          }
        },
        "event": {
          "name": "setup.complete",
          "description": "Test setup completed successfully",
          "attributes": {
            "config.nodes": {
              "type": "number",
              "description": "Number of nodes in test config",
              "required": false
            },
            "config.edges": {
              "type": "number",
              "description": "Number of edges in test config",
              "required": false
            },
            "positions.defined": {
              "type": "boolean",
              "description": "Whether node positions are defined",
              "required": false
            }
          }
        }
      }
    },
    {
      "id": "graph-converter",
      "type": "text",
      "text": "# Graph Converter\n\nConvert configuration to graph nodes and edges\n\n**Event:** execution.started",
      "x": 0,
      "y": 0,
      "width": 280,
      "height": 140,
      "pv": {
        "nodeType": "converter",
        "name": "Graph Converter",
        "description": "Graph conversion begins",
        "shape": "rectangle",
        "fill": "#3b82f6",
        "event": {
          "name": "execution.started",
          "description": "Graph conversion begins",
          "attributes": {
            "action": {
              "type": "string",
              "description": "Name of the action being executed",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "sources": [
          "packages/core/src/utils/GraphConverter.ts"
        ]
      }
    },
    {
      "id": "graph-converter-2",
      "type": "text",
      "text": "# Graph Converter\n\nConvert configuration to graph nodes and edges\n\n**Event:** execution.complete",
      "x": 0,
      "y": 150,
      "width": 280,
      "height": 140,
      "pv": {
        "nodeType": "converter",
        "name": "Graph Converter",
        "description": "Graph conversion finished successfully",
        "shape": "rectangle",
        "fill": "#3b82f6",
        "event": {
          "name": "execution.complete",
          "description": "Graph conversion finished successfully",
          "attributes": {
            "result.nodes.count": {
              "type": "number",
              "description": "Number of nodes in result graph",
              "required": true
            },
            "result.edges.count": {
              "type": "number",
              "description": "Number of edges in result graph",
              "required": false
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "sources": [
          "packages/core/src/utils/GraphConverter.ts"
        ]
      }
    },
    {
      "id": "assertions",
      "type": "text",
      "text": "# Assertions\n\nVerify conversion results\n\n**Event:** assertion.started",
      "x": 330,
      "y": 0,
      "width": 250,
      "height": 160,
      "pv": {
        "nodeType": "validator",
        "name": "Assertions",
        "description": "Begin verifying results",
        "shape": "diamond",
        "fill": "#10b981",
        "event": {
          "name": "assertion.started",
          "description": "Begin verifying results",
          "attributes": {
            "assertions": {
              "type": "string",
              "description": "Description of assertions being checked",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        }
      }
    },
    {
      "id": "assertions-2",
      "type": "text",
      "text": "# Assertions\n\nVerify conversion results\n\n**Event:** assertion.complete",
      "x": 330,
      "y": 150,
      "width": 250,
      "height": 160,
      "pv": {
        "nodeType": "validator",
        "name": "Assertions",
        "description": "All assertions verified",
        "shape": "diamond",
        "fill": "#10b981",
        "event": {
          "name": "assertion.complete",
          "description": "All assertions verified",
          "attributes": {
            "assertions.passed": {
              "type": "number",
              "description": "Number of assertions that passed",
              "required": true
            },
            "assertions.failed": {
              "type": "number",
              "description": "Number of assertions that failed",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        }
      }
    }
  ],
  "edges": [
    {
      "id": "setup-to-convert",
      "fromNode": "test-setup",
      "toNode": "graph-converter",
      "fromSide": "right",
      "toSide": "left",
      "label": "config ready",
      "pv": {
        "edgeType": "data-flow",
        "style": "solid"
      }
    },
    {
      "id": "convert-to-assert",
      "fromNode": "graph-converter",
      "toNode": "assertions",
      "fromSide": "right",
      "toSide": "left",
      "label": "graph output",
      "pv": {
        "edgeType": "data-flow",
        "style": "solid"
      }
    }
  ],
  "pv": {
    "version": "1.0.0",
    "name": "Graph Converter Tests",
    "description": "Test execution flow for the GraphConverter component. This canvas visualizes the test lifecycle: setup test data, execute the converter, and verify results through assertions.",
    "markdown": ".principal-views/graph-converter-test.md",
    "otel": {
      "defaultScope": "span.kind",
      "audit": {
        "framework": "Principal View Core",
        "version": "0.1.0",
        "author": "Principal AI"
      }
    }
  }
}
