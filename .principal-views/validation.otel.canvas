{
  "nodes": [
    {
      "id": "analysis-started",
      "type": "text",
      "text": "Analysis Started",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "color": "#4CAF50",
      "pv": {
        "name": "Analysis Started",
        "description": "Codebase composition analysis begins",
        "shape": "roundedRect",
        "icon": "Play",
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        },
        "event": {
          "name": "analysis.started",
          "attributes": {
            "repository.path": {
              "type": "string",
              "description": "Repository root path",
              "required": true
            },
            "analysis.type": {
              "type": "string",
              "description": "Type of analysis (discovery, validation, full)",
              "required": true
            }
          }
        },
        "sources": [
          "packages/core/src/discovery/CanvasDiscovery.ts",
          "packages/cli/src/commands/validate.ts"
        ]
      }
    },
    {
      "id": "filetree-built",
      "type": "text",
      "text": "FileTree Built",
      "x": 100,
      "y": 250,
      "width": 200,
      "height": 100,
      "color": "#2196F3",
      "pv": {
        "name": "FileTree Built",
        "description": "Repository file tree constructed",
        "shape": "roundedRect",
        "icon": "FolderTree",
        "otel": {
          "kind": "event",
          "category": "operation",
          "isNew": false
        },
        "event": {
          "name": "filetree.built",
          "attributes": {
            "files.total": {
              "type": "integer",
              "description": "Total files in repository",
              "required": true
            },
            "filetree.sha": {
              "type": "string",
              "description": "Content hash for caching",
              "required": true
            }
          }
        },
        "sources": ["packages/core/src/discovery/CanvasDiscovery.ts"]
      }
    },
    {
      "id": "packages-discovered",
