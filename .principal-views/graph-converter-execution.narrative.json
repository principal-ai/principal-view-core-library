{
  "version": "1.0.0",
  "canvas": "graph-converter-execution.otel.canvas",
  "name": "Graph Converter Execution Narrative",
  "description": "Human-readable narrative for graph conversion process",
  "mode": "span-tree",
  "scenarioSelection": "first-match",
  "showLogsPerSpan": true,
  "scenarios": [
    {
      "id": "conversion-error",
      "priority": 1,
      "description": "Conversion failed with error",
      "condition": {
        "requires": ["conversion.error"]
      },
      "template": {
        "introduction": "❌ Graph Conversion Failed\n{'━'.repeat(50)}",
        "span": "→ {span.name}",
        "children": "recurse",
        "events": {
          "validation.started": "  🔍 Validating configuration ({config.size} bytes)",
          "validation.complete": "{validation.passed === true ? '  ✅ Validation passed' : '  ❌ Validation failed with {errors.count} errors'}",
          "conversion.started": "  🔄 Converting {config.nodeTypes} node types and {config.edgeTypes} edge types",
          "conversion.processingNodes": "  📊 Processing {nodes.count} nodes",
          "conversion.processingEdges": "  🔗 Processing {edges.count} edges",
          "conversion.error": "  ❌ Error in {error.phase ? error.phase : 'conversion'}: {error.message}"
        },
        "logs": {
          "error": "    ❌ {log.body}",
          "warn": "    ⚠️  {log.body}",
          "info": "    ℹ️  {log.body}",
          "debug": "    🔍 {log.body}"
        },
        "summary": "{'━'.repeat(50)}\n\n❌ Conversion failed: {error.message}"
      }
    },
    {
      "id": "validation-failed",
      "priority": 2,
      "description": "Validation failed before conversion",
      "condition": {
        "requires": ["validation.complete"],
        "assertions": {
          "validation.passed": { "$eq": false }
        }
      },
      "template": {
        "introduction": "⚠️  Graph Conversion - Validation Failed\n{'━'.repeat(50)}",
        "span": "→ {span.name}",
        "children": "recurse",
        "events": {
          "validation.started": "  🔍 Validating configuration ({config.size} bytes)",
          "validation.complete": "  ❌ Validation failed with {errors.count} errors"
        },
        "logs": {
          "error": "    ❌ {log.body}",
          "warn": "    ⚠️  {log.body}",
          "info": "    ℹ️  {log.body}"
        },
        "summary": "{'━'.repeat(50)}\n\n⚠️  Configuration validation failed with {errors.count} errors.\nConversion was not attempted."
      }
    },
    {
      "id": "conversion-success",
      "priority": 3,
      "description": "Successful conversion",
      "condition": {
        "requires": ["conversion.complete"],
        "assertions": {
          "validation.passed": { "$eq": true }
        }
      },
      "template": {
        "introduction": "✅ Graph Conversion Complete\n{'━'.repeat(50)}",
        "span": "→ {span.name}",
        "children": "recurse",
        "events": {
          "validation.started": "  🔍 Validating configuration ({config.size} bytes)",
          "validation.complete": "  ✅ Validation passed",
          "conversion.started": "  🔄 Converting {config.nodeTypes} node types and {config.edgeTypes} edge types",
          "conversion.processingNodes": "  📊 Processing {nodes.count} nodes",
          "conversion.processingEdges": "  🔗 Processing {edges.count} edges",
          "conversion.complete": "  ✅ Generated {result.nodes.count} nodes and {result.edges.count} edges{duration.ms ? ' in ' + duration.ms + 'ms' : ''}",
          "output.created": "  📦 Created {output.type} output"
        },
        "logs": {
          "error": "    ❌ {log.body}",
          "warn": "    ⚠️  {log.body}",
          "info": "    ℹ️  {log.body}",
          "debug": "    🔍 {log.body}"
        },
        "summary": "{'━'.repeat(50)}\n\n✅ Successfully converted configuration to graph:\n  • {result.nodes.count} nodes\n  • {result.edges.count} edges\n{duration.ms ? '  • Duration: ' + duration.ms + 'ms' : ''}"
      }
    },
    {
      "id": "default",
      "priority": 99,
      "description": "Default fallback scenario",
      "condition": {
        "default": true
      },
      "template": {
        "introduction": "📋 Graph Conversion Process\n{'━'.repeat(50)}",
        "span": "→ {span.name}",
        "children": "recurse",
        "events": {
          "validation.started": "  🔍 Validation started",
          "validation.complete": "  ✅ Validation complete",
          "conversion.started": "  🔄 Conversion started",
          "conversion.processingNodes": "  📊 Processing nodes",
          "conversion.processingEdges": "  🔗 Processing edges",
          "conversion.complete": "  ✅ Conversion complete",
          "conversion.error": "  ❌ Error: {error.message}",
          "output.created": "  📦 Output created"
        },
        "logs": {
          "error": "    ❌ {log.body}",
          "warn": "    ⚠️  {log.body}",
          "info": "    ℹ️  {log.body}",
          "debug": "    🔍 {log.body}"
        },
        "summary": "{'━'.repeat(50)}\n\nGraph conversion process executed."
      }
    }
  ],
  "formatting": {
    "indentSize": 2,
    "showTimestamps": false,
    "emptyLinesBetweenSections": 1
  }
}
