{
  "nodes": [
    {
      "id": "test-start",
      "type": "text",
      "text": "# Test Start\n\nInitialize test case for rules engine",
      "x": -323,
      "y": 15,
      "width": 250,
      "height": 120,
      "pv": {
        "nodeType": "test",
        "name": "Test Start",
        "description": "Initialize test case",
        "shape": "hexagon",
        "fill": "#8b5cf6",
        "otel": {
          "resourceMatch": {
            "span.kind": "test.case"
          }
        },
        "event": {
          "name": "test.started",
          "description": "Test case execution begins",
          "attributes": {
            "test.type": {
              "type": "string",
              "description": "Type of test (integration, unit, etc.)",
              "required": true
            },
            "test.subject": {
              "type": "string",
              "description": "Subject under test",
              "required": true
            },
            "test.expectation": {
              "type": "string",
              "description": "Expected outcome",
              "required": false
            }
          }
        }
      }
    },
    {
      "id": "engine-create",
      "type": "text",
      "text": "# Engine Creation\n\nCreate default rules engine with all builtin rules\n\n**Event:** engine.creating",
      "x": 0,
      "y": 4,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "factory",
        "name": "Engine Creation",
        "description": "Starting engine initialization",
        "shape": "rectangle",
        "fill": "#3b82f6",
        "event": {
          "name": "engine.creating",
          "description": "Starting engine initialization",
          "attributes": {
            "engine.type": {
              "type": "string",
              "description": "Type of engine (default, custom)",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "operation",
          "isNew": true
        },
        "sources": [
          "packages/core/src/rules/engine.ts"
        ]
      }
    },
    {
      "id": "engine-create-2",
      "type": "text",
      "text": "# Engine Creation\n\nCreate default rules engine with all builtin rules\n\n**Event:** engine.created",
      "x": 0,
      "y": 154,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "factory",
        "name": "Engine Creation",
        "description": "Engine initialized successfully",
        "shape": "rectangle",
        "fill": "#3b82f6",
        "event": {
          "name": "engine.created",
          "description": "Engine initialized successfully",
          "attributes": {
            "engine.rules.count": {
              "type": "number",
              "description": "Number of registered rules",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "operation",
          "isNew": true
        },
        "sources": [
          "packages/core/src/rules/engine.ts"
        ]
      }
    },
    {
      "id": "lint-start",
      "type": "text",
      "text": "# Lint Configuration\n\nBegin linting configuration against all rules",
      "x": 301,
      "y": 4,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "validator",
        "name": "Lint Start",
        "description": "Begin configuration validation",
        "shape": "hexagon",
        "fill": "#10b981",
        "event": {
          "name": "lint.starting",
          "description": "Starting configuration validation",
          "attributes": {
            "config.node.types.count": {
              "type": "number",
              "description": "Number of node types in config",
              "required": false
            },
            "config.edge.types.count": {
              "type": "number",
              "description": "Number of edge types in config",
              "required": false
            },
            "config.connections.count": {
              "type": "number",
              "description": "Number of allowed connections",
              "required": false
            },
            "config.has.violations": {
              "type": "boolean",
              "description": "Whether config is expected to have violations",
              "required": false
            },
            "config.severity.override": {
              "type": "string",
              "description": "Severity overrides applied",
              "required": false
            },
            "config.disabled.rules": {
              "type": "string",
              "description": "Comma-separated list of disabled rules",
              "required": false
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        }
      }
    },
    {
      "id": "rule-execute",
      "type": "text",
      "text": "# Rule Execution\n\nExecute individual validation rules\n\n**Event:** rule.completed",
      "x": 601,
      "y": -6,
      "width": 250,
      "height": 160,
      "pv": {
        "nodeType": "processor",
        "name": "Rule Execution",
        "description": "Rule execution finished",
        "shape": "rectangle",
        "fill": "#f59e0b",
        "otel": {
          "resourceMatch": {
            "rule.id": "*"
          }
        },
        "event": {
          "name": "rule.completed",
          "description": "Rule execution finished",
          "attributes": {
            "rule.violations.count": {
              "type": "number",
              "description": "Number of violations found by this rule",
              "required": true
            },
            "rule.duration.ms": {
              "type": "number",
              "description": "Rule execution time in milliseconds",
              "required": true
            }
          }
        }
      }
    },
    {
      "id": "rule-execute-2",
      "type": "text",
      "text": "# Rule Execution\n\nExecute individual validation rules\n\n**Event:** rule.error",
      "x": 601,
      "y": 144,
      "width": 250,
      "height": 160,
      "pv": {
        "nodeType": "processor",
        "name": "Rule Execution",
        "description": "Rule execution failed",
        "shape": "rectangle",
        "fill": "#f59e0b",
        "otel": {
          "resourceMatch": {
            "rule.id": "*"
          }
        },
        "event": {
          "name": "rule.error",
          "description": "Rule execution failed",
          "attributes": {
            "error.message": {
              "type": "string",
              "description": "Error message",
              "required": true
            },
            "error.type": {
              "type": "string",
              "description": "Error type/class",
              "required": false
            }
          }
        }
      }
    },
    {
      "id": "violations-detect",
      "type": "text",
      "text": "# Violations Detection\n\nAggregate violations from all rules",
      "x": 601,
      "y": 229,
      "width": 250,
      "height": 140,
      "pv": {
        "nodeType": "aggregator",
        "name": "Violations Detection",
        "description": "Collect and categorize violations",
        "shape": "diamond",
        "fill": "#ef4444",
        "event": {
          "name": "violations.detected",
          "description": "Rule found violations",
          "attributes": {
            "rule.id": {
              "type": "string",
              "description": "ID of rule that found violations",
              "required": true
            },
            "rule.category": {
              "type": "string",
              "description": "Category of rule",
              "required": true
            },
            "violations.count": {
              "type": "number",
              "description": "Number of violations found",
              "required": true
            },
            "violations.severity": {
              "type": "string",
              "description": "Severity of violations (error, warn)",
              "required": true
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "discovery",
          "isNew": true
        }
      }
    },
    {
      "id": "lint-complete",
      "type": "text",
      "text": "# Lint Results\n\nFinalize validation results with statistics\n\n**Event:** lint.completed",
      "x": 929,
      "y": 226,
      "width": 230,
      "height": 146,
      "pv": {
        "nodeType": "output",
        "name": "Lint Complete",
        "description": "Configuration validation finished",
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "event": {
          "name": "lint.completed",
          "description": "Configuration validation finished",
          "attributes": {
            "result.violations.total": {
              "type": "number",
              "description": "Total number of violations",
              "required": true
            },
            "result.violations.errors": {
              "type": "number",
              "description": "Number of error-level violations",
              "required": true
            },
            "result.violations.warnings": {
              "type": "number",
              "description": "Number of warning-level violations",
              "required": true
            },
            "result.violations.fixable": {
              "type": "number",
              "description": "Number of auto-fixable violations",
              "required": false
            },
            "violation.color.severity": {
              "type": "string",
              "description": "Severity override verification",
              "required": false
            },
            "violation.color.disabled": {
              "type": "boolean",
              "description": "Whether color rule was disabled",
              "required": false
            },
            "violation.sources.disabled": {
              "type": "boolean",
              "description": "Whether sources rule was disabled",
              "required": false
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "lifecycle",
          "isNew": true
        }
      }
    },
    {
      "id": "lint-complete-2",
      "type": "text",
      "text": "# Lint Results\n\nFinalize validation results with statistics\n\n**Event:** violations.analyzed",
      "x": 929,
      "y": 376,
      "width": 230,
      "height": 146,
      "pv": {
        "nodeType": "output",
        "name": "Lint Complete",
        "description": "Specific violations examined",
        "shape": "rectangle",
        "fill": "#8b5cf6",
        "event": {
          "name": "violations.analyzed",
          "description": "Specific violations examined",
          "attributes": {
            "violation.required-metadata.found": {
              "type": "boolean",
              "description": "Whether metadata violation was found",
              "required": false
            },
            "violation.valid-color-format.found": {
              "type": "boolean",
              "description": "Whether color format violation was found",
              "required": false
            },
            "violation.minimum-node-sources.found": {
              "type": "boolean",
              "description": "Whether sources violation was found",
              "required": false
            }
          }
        },
        "otel": {
          "kind": "event",
          "category": "operation",
          "isNew": true
        }
      }
    }
  ],
  "edges": [
    {
      "id": "test-to-engine",
      "fromNode": "test-start",
      "toNode": "engine-create",
      "fromSide": "right",
      "toSide": "left",
      "label": "initialize",
      "pv": {
        "edgeType": "control-flow",
        "style": "solid"
      }
    },
    {
      "id": "engine-to-lint",
      "fromNode": "engine-create",
      "toNode": "lint-start",
      "fromSide": "right",
      "toSide": "left",
      "label": "begin validation",
      "pv": {
        "edgeType": "control-flow",
        "style": "solid"
      }
    },
    {
      "id": "lint-to-rules",
      "fromNode": "lint-start",
      "toNode": "rule-execute",
      "fromSide": "right",
      "toSide": "left",
      "label": "execute rules",
      "pv": {
        "edgeType": "control-flow",
        "style": "solid"
      }
    },
    {
      "id": "rules-to-violations",
      "fromNode": "rule-execute",
      "toNode": "violations-detect",
      "fromSide": "bottom",
      "toSide": "top",
      "label": "report violations",
      "pv": {
        "edgeType": "data-flow",
        "style": "dashed"
      }
    },
    {
      "id": "violations-to-complete",
      "fromNode": "violations-detect",
      "toNode": "lint-complete",
      "fromSide": "right",
      "toSide": "left",
      "label": "aggregate results",
      "pv": {
        "edgeType": "data-flow",
        "style": "solid"
      }
    },
    {
      "id": "rules-to-complete",
      "fromNode": "rule-execute",
      "toNode": "lint-complete",
      "fromSide": "right",
      "toSide": "top",
      "label": "all rules done",
      "pv": {
        "edgeType": "control-flow",
        "style": "dotted"
      }
    }
  ],
  "pv": {
    "version": "1.0.0",
    "name": "Rules Engine Execution",
    "description": "Execution flow for the Principal View rules engine validation system. This canvas shows how configuration files are validated through a series of rules, with violations detected and aggregated.",
    "markdown": ".principal-views/rules-engine-execution.md",
    "otel": {
      "defaultScope": "span.kind",
      "audit": {
        "framework": "Principal View Core",
        "version": "0.1.0",
        "author": "Principal AI"
      }
    }
  }
}
