{
  "name": "Validation Pipeline",
  "markdown": ".principal-views/validation.md",
  "description": "Complete validation workflow from codebase composition analysis through validation to results",
  "nodeTypes": {
    "event": {
      "label": "Event",
      "description": "An OpenTelemetry event emitted during validation",
      "color": "#9C27B0"
    }
  },
  "edgeTypes": {
    "sequence": {
      "label": "Then",
      "style": "solid",
      "color": "#666",
      "width": 2,
      "directed": true
    },
    "discovery": {
      "label": "Discover",
      "style": "dashed",
      "color": "#FF9800",
      "width": 2,
      "directed": true
    },
    "branch": {
      "label": "Route",
      "style": "dashed",
      "color": "#9C27B0",
      "width": 2,
      "directed": true
    },
    "error-path": {
      "label": "Error",
      "style": "dashed",
      "color": "#F44336",
      "width": 2,
      "directed": true
    }
  },
  "nodes": [
    {
      "id": "analysis-started",
      "type": "otel-event",
      "x": 100,
      "y": 50,
      "width": 200,
      "height": 100,
      "label": "Analysis Started",
      "icon": "Play",
      "shape": "roundedRect",
      "event": {
        "name": "analysis.started",
        "attributes": {
          "repository.path": {
            "type": "string",
            "description": "Repository root path",
            "required": true
          },
          "analysis.type": {
            "type": "string",
            "description": "Type of analysis (discovery, validation, full)",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "filetree-built",
      "type": "otel-event",
      "x": 100,
      "y": 250,
      "width": 200,
      "height": 100,
      "label": "FileTree Built",
      "icon": "FolderTree",
      "shape": "roundedRect",
      "event": {
        "name": "filetree.built",
        "attributes": {
          "files.total": {
            "type": "integer",
            "description": "Total files in repository",
            "required": true
          },
          "filetree.sha": {
            "type": "string",
            "description": "Content hash for caching",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "packages-discovered",
      "type": "otel-event",
      "x": 100,
      "y": 450,
      "width": 200,
      "height": 100,
      "label": "Packages Discovered",
      "icon": "Package",
      "shape": "roundedRect",
      "event": {
        "name": "packages.discovered",
        "attributes": {
          "packages.count": {
            "type": "integer",
            "description": "Number of packages found",
            "required": true
          },
          "packages.names": {
            "type": "string[]",
            "description": "Package names",
            "required": false
          },
          "repository.type": {
            "type": "string",
            "description": "Repository type (monorepo, single-package)",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "canvases-discovered",
      "type": "otel-event",
      "x": 450,
      "y": 250,
      "width": 200,
      "height": 100,
      "label": "Canvases Discovered",
      "icon": "FileJson",
      "shape": "roundedRect",
      "event": {
        "name": "canvases.discovered",
        "attributes": {
          "canvases.total": {
            "type": "integer",
            "description": "Total canvas files found",
            "required": true
          },
          "canvases.regular": {
            "type": "integer",
            "description": "Regular .canvas files",
            "required": true
          },
          "canvases.otel": {
            "type": "integer",
            "description": "OTEL .otel.canvas files",
            "required": true
          },
          "canvases.byPackage": {
            "type": "object",
            "description": "Canvas count per package",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "executions-discovered",
      "type": "otel-event",
      "x": 450,
      "y": 400,
      "width": 200,
      "height": 100,
      "label": "Executions Discovered",
      "icon": "Activity",
      "shape": "roundedRect",
      "event": {
        "name": "executions.discovered",
        "attributes": {
          "executions.total": {
            "type": "integer",
            "description": "Total execution files found",
            "required": true
          },
          "executions.byCanvas": {
            "type": "object",
            "description": "Execution count per canvas",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "library-loaded",
      "type": "otel-event",
      "x": 450,
      "y": 550,
      "width": 200,
      "height": 100,
      "label": "Library Loaded",
      "icon": "Library",
      "shape": "roundedRect",
      "event": {
        "name": "library.loaded",
        "attributes": {
          "library.found": {
            "type": "boolean",
            "description": "Whether library file exists",
            "required": true
          },
          "library.path": {
            "type": "string",
            "description": "Path to library file",
            "required": false
          },
          "nodeComponents.count": {
            "type": "integer",
            "description": "Number of node component types",
            "required": false
          },
          "edgeComponents.count": {
            "type": "integer",
            "description": "Number of edge component types",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "discovery-complete",
      "type": "otel-event",
      "x": 100,
      "y": 650,
      "width": 200,
      "height": 100,
      "label": "Discovery Complete",
      "icon": "CheckSquare",
      "shape": "roundedRect",
      "event": {
        "name": "discovery.complete",
        "attributes": {
          "discovery.duration": {
            "type": "number",
            "description": "Discovery duration in milliseconds",
            "required": false
          },
          "items.discovered": {
            "type": "integer",
            "description": "Total items discovered",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "validation-started",
      "type": "otel-event",
      "x": 100,
      "y": 850,
      "width": 200,
      "height": 100,
      "label": "Validation Started",
      "icon": "PlayCircle",
      "shape": "roundedRect",
      "event": {
        "name": "validation.started",
        "attributes": {
          "validation.type": {
            "type": "string",
            "description": "Type of validation (canvas, workflow, execution, library, config, rules, event)",
            "required": true
          },
          "input.fileCount": {
            "type": "integer",
            "description": "Number of files to validate",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "file-parsed",
      "type": "otel-event",
      "x": 100,
      "y": 1050,
      "width": 200,
      "height": 100,
      "label": "File Parsed",
      "icon": "FileJson",
      "shape": "roundedRect",
      "event": {
        "name": "file.parsed",
        "attributes": {
          "file.path": {
            "type": "string",
            "description": "Path to parsed file",
            "required": true
          },
          "file.format": {
            "type": "string",
            "description": "File format (json, yaml)",
            "required": true
          },
          "file.size": {
            "type": "integer",
            "description": "File size in bytes",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "type-detected",
      "type": "otel-event",
      "x": 100,
      "y": 1250,
      "width": 200,
      "height": 100,
      "label": "Validation Type Detected",
      "icon": "GitBranch",
      "shape": "roundedRect",
      "event": {
        "name": "type.detected",
        "attributes": {
          "detected.type": {
            "type": "string",
            "description": "Detected validation type",
            "required": true
          },
          "detection.method": {
            "type": "string",
            "description": "How type was detected (file extension, content, explicit)",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "canvas-validated",
      "type": "otel-event",
      "x": 450,
      "y": 1050,
      "width": 200,
      "height": 100,
      "label": "Canvas Validated",
      "icon": "CheckSquare",
      "shape": "roundedRect",
      "event": {
        "name": "canvas.validated",
        "attributes": {
          "canvas.type": {
            "type": "string",
            "description": "Canvas type (standard, otel)",
            "required": true
          },
          "checks.total": {
            "type": "integer",
            "description": "Total validation checks performed",
            "required": true
          },
          "checks.passed": {
            "type": "integer",
            "description": "Checks that passed",
            "required": true
          },
          "checks.failed": {
            "type": "integer",
            "description": "Checks that failed",
            "required": true
          },
          "nodes.count": {
            "type": "integer",
            "description": "Number of nodes validated",
            "required": false
          },
          "edges.count": {
            "type": "integer",
            "description": "Number of edges validated",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "workflow-validated",
      "type": "otel-event",
      "x": 450,
      "y": 1200,
      "width": 200,
      "height": 100,
      "label": "Workflow Validated",
      "icon": "FileText",
      "shape": "roundedRect",
      "event": {
        "name": "workflow.validated",
        "attributes": {
          "scenarios.count": {
            "type": "integer",
            "description": "Number of scenarios validated",
            "required": true
          },
          "violations.count": {
            "type": "integer",
            "description": "Total violations found",
            "required": true
          },
          "errors.count": {
            "type": "integer",
            "description": "Error violations",
            "required": true
          },
          "warnings.count": {
            "type": "integer",
            "description": "Warning violations",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "execution-validated",
      "type": "otel-event",
      "x": 450,
      "y": 1350,
      "width": 200,
      "height": 100,
      "label": "Execution Validated",
      "icon": "Activity",
      "shape": "roundedRect",
      "event": {
        "name": "execution.validated",
        "attributes": {
          "format": {
            "type": "string",
            "description": "Format detected (OTLP, ExecutionData)",
            "required": true
          },
          "spans.count": {
            "type": "integer",
            "description": "Number of spans validated",
            "required": true
          },
          "events.count": {
            "type": "integer",
            "description": "Total events across all spans",
            "required": true
          },
          "errors.count": {
            "type": "integer",
            "description": "Validation errors found",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "library-validated",
      "type": "otel-event",
      "x": 450,
      "y": 1500,
      "width": 200,
      "height": 100,
      "label": "Library Validated",
      "icon": "Library",
      "shape": "roundedRect",
      "event": {
        "name": "library.validated",
        "attributes": {
          "nodeComponents.count": {
            "type": "integer",
            "description": "Number of node components",
            "required": true
          },
          "edgeComponents.count": {
            "type": "integer",
            "description": "Number of edge components",
            "required": true
          },
          "issues.count": {
            "type": "integer",
            "description": "Total issues found",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "rules-executed",
      "type": "otel-event",
      "x": 450,
      "y": 1650,
      "width": 200,
      "height": 100,
      "label": "Rules Executed",
      "icon": "ListChecks",
      "shape": "roundedRect",
      "event": {
        "name": "rules.executed",
        "attributes": {
          "rules.count": {
            "type": "integer",
            "description": "Number of rules executed",
            "required": true
          },
          "violations.total": {
            "type": "integer",
            "description": "Total violations found",
            "required": true
          },
          "violations.error": {
            "type": "integer",
            "description": "Error-level violations",
            "required": true
          },
          "violations.warning": {
            "type": "integer",
            "description": "Warning-level violations",
            "required": true
          },
          "fixable.count": {
            "type": "integer",
            "description": "Auto-fixable violations",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "results-aggregated",
      "type": "otel-event",
      "x": 100,
      "y": 1450,
      "width": 200,
      "height": 100,
      "label": "Results Aggregated",
      "icon": "Layers",
      "shape": "roundedRect",
      "event": {
        "name": "results.aggregated",
        "attributes": {
          "total.files": {
            "type": "integer",
            "description": "Total files validated",
            "required": true
          },
          "total.errors": {
            "type": "integer",
            "description": "Total errors across all validations",
            "required": true
          },
          "total.warnings": {
            "type": "integer",
            "description": "Total warnings across all validations",
            "required": true
          },
          "validations.performed": {
            "type": "string[]",
            "description": "Types of validations performed",
            "required": true
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "validation-complete",
      "type": "otel-event",
      "x": 100,
      "y": 1650,
      "width": 200,
      "height": 100,
      "label": "Validation Complete",
      "icon": "CheckCircle2",
      "shape": "roundedRect",
      "event": {
        "name": "validation.complete",
        "attributes": {
          "result.valid": {
            "type": "boolean",
            "description": "Overall validation result",
            "required": true
          },
          "result.validCount": {
            "type": "integer",
            "description": "Number of valid items",
            "required": true
          },
          "result.invalidCount": {
            "type": "integer",
            "description": "Number of invalid items",
            "required": true
          },
          "duration.ms": {
            "type": "number",
            "description": "Total validation duration",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    },
    {
      "id": "validation-error",
      "type": "otel-event",
      "x": 800,
      "y": 1250,
      "width": 200,
      "height": 100,
      "label": "Validation Error",
      "icon": "XCircle",
      "shape": "roundedRect",
      "event": {
        "name": "validation.error",
        "attributes": {
          "error.type": {
            "type": "string",
            "description": "Error type (parse, schema, reference, structure)",
            "required": true
          },
          "error.message": {
            "type": "string",
            "description": "Error message",
            "required": true
          },
          "error.stage": {
            "type": "string",
            "description": "Stage where error occurred",
            "required": true
          },
          "error.file": {
            "type": "string",
            "description": "File that caused the error",
            "required": false
          },
          "error.line": {
            "type": "integer",
            "description": "Line number where error occurred",
            "required": false
          }
        }
      },
      "otel": {
        "status": "draft",
        "scope": "principal-view.cli"
      }
    }
  ],
  "edges": [
    {
      "id": "start-to-filetree",
      "fromNode": "analysis-started",
      "toNode": "filetree-built",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "filetree-to-packages",
      "fromNode": "filetree-built",
      "toNode": "packages-discovered",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "packages-to-canvases",
      "fromNode": "packages-discovered",
      "toNode": "canvases-discovered",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "discovery"
    },
    {
      "id": "packages-to-executions",
      "fromNode": "packages-discovered",
      "toNode": "executions-discovered",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "discovery"
    },
    {
      "id": "packages-to-library",
      "fromNode": "packages-discovered",
      "toNode": "library-loaded",
      "fromSide": "right",
      "toSide": "left",
      "edgeType": "discovery"
    },
    {
      "id": "canvases-to-complete",
      "fromNode": "canvases-discovered",
      "toNode": "discovery-complete",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "executions-to-complete",
      "fromNode": "executions-discovered",
      "toNode": "discovery-complete",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "library-to-complete",
      "fromNode": "library-loaded",
      "toNode": "discovery-complete",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "discovery-to-validation",
      "fromNode": "discovery-complete",
      "toNode": "validation-started",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "validation-to-parse",
      "fromNode": "validation-started",
      "toNode": "file-parsed",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "parse-to-detect",
      "fromNode": "file-parsed",
      "toNode": "type-detected",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "detect-to-canvas",
      "fromNode": "type-detected",
      "toNode": "canvas-validated",
      "fromSide": "right",
      "toSide": "left",
      "label": "canvas",
      "edgeType": "branch"
    },
    {
      "id": "detect-to-workflow",
      "fromNode": "type-detected",
      "toNode": "workflow-validated",
      "fromSide": "right",
      "toSide": "left",
      "label": "workflow",
      "edgeType": "branch"
    },
    {
      "id": "detect-to-execution",
      "fromNode": "type-detected",
      "toNode": "execution-validated",
      "fromSide": "right",
      "toSide": "left",
      "label": "execution",
      "edgeType": "branch"
    },
    {
      "id": "detect-to-library",
      "fromNode": "type-detected",
      "toNode": "library-validated",
      "fromSide": "right",
      "toSide": "left",
      "label": "library",
      "edgeType": "branch"
    },
    {
      "id": "detect-to-rules",
      "fromNode": "type-detected",
      "toNode": "rules-executed",
      "fromSide": "right",
      "toSide": "left",
      "label": "lint",
      "edgeType": "branch"
    },
    {
      "id": "canvas-to-aggregate",
      "fromNode": "canvas-validated",
      "toNode": "results-aggregated",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "workflow-to-aggregate",
      "fromNode": "workflow-validated",
      "toNode": "results-aggregated",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "execution-to-aggregate",
      "fromNode": "execution-validated",
      "toNode": "results-aggregated",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "library-to-aggregate",
      "fromNode": "library-validated",
      "toNode": "results-aggregated",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "rules-to-aggregate",
      "fromNode": "rules-executed",
      "toNode": "results-aggregated",
      "fromSide": "left",
      "toSide": "right",
      "edgeType": "sequence"
    },
    {
      "id": "aggregate-to-complete",
      "fromNode": "results-aggregated",
      "toNode": "validation-complete",
      "fromSide": "bottom",
      "toSide": "top",
      "edgeType": "sequence"
    },
    {
      "id": "parse-to-error",
      "fromNode": "file-parsed",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "parse failure",
      "edgeType": "error-path"
    },
    {
      "id": "canvas-to-error",
      "fromNode": "canvas-validated",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "validation failure",
      "edgeType": "error-path"
    },
    {
      "id": "workflow-to-error",
      "fromNode": "workflow-validated",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "validation failure",
      "edgeType": "error-path"
    },
    {
      "id": "execution-to-error",
      "fromNode": "execution-validated",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "validation failure",
      "edgeType": "error-path"
    },
    {
      "id": "library-to-error",
      "fromNode": "library-validated",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "validation failure",
      "edgeType": "error-path"
    },
    {
      "id": "rules-to-error",
      "fromNode": "rules-executed",
      "toNode": "validation-error",
      "fromSide": "right",
      "toSide": "left",
      "label": "rule violations",
      "edgeType": "error-path"
    }
  ]
}
