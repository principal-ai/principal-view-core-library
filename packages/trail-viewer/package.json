{
	"name": "@principal-ai/trail-viewer",
	"version": "0.3.1",
	"description": "Standalone viewer for Principal ADE trails. Pairs with the principal-ai CLI: `principal-ai trail view <id>` shells into this bundle.",
	"type": "module",
	"os": [
		"darwin"
	],
	"cpu": [
		"arm64"
	],
	"bin": {
		"principal-trail-viewer": "bin/trail-viewer.cjs"
	},
	"files": [
		"bin",
		"bundles"
	],
	"scripts": {
		"start": "electrobun dev",
		"dev": "electrobun dev --watch",
		"build:canary": "electrobun build --env=canary",
		"build:bundle": "bun run build:canary && bun scripts/stage-bundle.ts",
		"prepack": "bun run build:bundle"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"devDependencies": {
		"@industry-theme/file-city-panel": "^0.5.155",
		"@principal-ade/dynamic-file-tree": "^0.2.45",
		"@principal-ade/industry-theme": "^0.1.22",
		"@principal-ade/panel-framework-core": "^0.5.1",
		"@principal-ade/panel-layouts": "^0.4.8",
		"@principal-ade/utcp-panel-event": "^0.1.0",
		"@principal-ai/alexandria-core-library": "^0.6.2",
		"@principal-ai/file-city-builder": "^0.4.11",
		"@principal-ai/file-city-react": "^0.5.53",
		"@principal-ai/logo-component": "^0.1.22",
		"@principal-ai/principal-view-core": "^0.28.6",
		"@principal-ai/repository-abstraction": "^0.5.7",
		"@types/bun": "latest",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"electrobun": "1.18.1",
		"lucide-react": "^1.17.0",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"typescript": "^6.0.3"
	}
}
