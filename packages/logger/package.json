{
  "name": "@principal-ai/principal-view-logger",
  "version": "0.3.0",
  "description": "Logger with OpenTelemetry integration for easy telemetry export",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build:clean && bun run build:ts",
    "build:clean": "rm -rf dist",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.57.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/api-logs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.57.0",
    "@opentelemetry/sdk-logs": "0.57.0",
    "@opentelemetry/sdk-trace-node": "1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.57.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.57.0",
    "@opentelemetry/resources": "1.30.0",
    "@opentelemetry/semantic-conventions": "1.28.0",
    "@types/jest": "30.0.0",
    "jest": "30.1.3",
    "typescript": "5.0.4"
  },
  "keywords": [
    "logger",
    "opentelemetry",
    "otel",
    "telemetry",
    "observability",
    "tracing"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
