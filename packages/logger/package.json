{
  "name": "@principal-ai/visual-validation-logger",
  "version": "0.1.0",
  "description": "Enhanced logger with automatic source path capture for visual validation framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "bun run build:clean && bun run build:ts",
    "build:clean": "rm -rf dist",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@principal-ai/visual-validation-core": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.1.3",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "logger",
    "source-capture",
    "visual-validation",
    "observability",
    "event-driven"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
