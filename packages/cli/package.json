{
  "name": "@principal-ai/visual-validation-cli",
  "version": "0.1.10",
  "description": "Visual Validation CLI - Validate and manage .canvas configuration files",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "bin": {
    "vv": "dist/index.cjs",
    "visual-validation": "dist/index.cjs"
  },
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun run build:lib && bun run build:cli",
    "build:lib": "tsc -p tsconfig.build.json",
    "build:cli": "bun build/build-cli.ts",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "visual-validation",
    "cli",
    "canvas",
    "graph",
    "validation",
    "principal-ai"
  ],
  "author": "Principal AI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "globby": "^16.0.0",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
