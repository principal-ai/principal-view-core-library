{
  "name": "@principal-ai/visual-validation-core",
  "version": "0.5.6",
  "description": "Core logic and types for graph-based visual validation framework",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "bun run build:clean && bun run build:ts",
    "build:clean": "rm -rf dist",
    "build:ts": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "zod": "^3.22.0",
    "date-fns": "^3.0.0",
    "@principal-ai/repository-abstraction": "^0.2.5",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "jest": "^30.1.3",
    "typescript": "^5.0.4"
  },
  "keywords": [
    "validation",
    "graph",
    "visualization",
    "testing",
    "event-driven"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
